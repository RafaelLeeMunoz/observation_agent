{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merge-v1",
  "title": "Merger output: which part groups are the same recurring process",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_id",
    "attempt_id",
    "processes"
  ],
  "properties": {
    "input_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "process_id",
          "parts",
          "reason",
          "name",
          "description",
          "trigger",
          "output",
          "roles",
          "automation",
          "minutes_per_event"
        ],
        "properties": {
          "process_id": {
            "type": "string",
            "description": "M1, M2, ..."
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "The part group ids (e.g. s002.P3) that are this one process."
          },
          "reason": {
            "type": "string",
            "description": "One line: why these groups are the same kind of work."
          },
          "name": {
            "type": "string",
            "description": "A short name for the recurring work, no numbers."
          },
          "description": {
            "type": "string",
            "description": "One or two sentences: what the work is and where it stalls, no numbers."
          },
          "trigger": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "automation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "idea",
              "artifact_type",
              "why"
            ],
            "properties": {
              "idea": {
                "type": "string"
              },
              "artifact_type": {
                "enum": [
                  "sop",
                  "checklist",
                  "email",
                  "template"
                ]
              },
              "why": {
                "type": "string"
              }
            }
          },
          "minutes_per_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "low",
              "base",
              "high",
              "rationale",
              "basis_obs_ids"
            ],
            "properties": {
              "low": {
                "type": "integer",
                "minimum": 1
              },
              "base": {
                "type": "integer",
                "minimum": 1
              },
              "high": {
                "type": "integer",
                "minimum": 1
              },
              "rationale": {
                "type": "string"
              },
              "basis_obs_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
