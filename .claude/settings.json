{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" -I \"$CLAUDE_PROJECT_DIR/tools/fence_hook.py\" --from-settings",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill(observe)",
      "Bash(.venv/Scripts/python -m src.ingest:*)",
      "Bash(.venv/Scripts/python -m src.pipeline:*)",
      "Bash(.venv/Scripts/python -m src.serve:*)",
      "Bash(.venv\\Scripts\\python -m src.ingest:*)",
      "Bash(.venv\\Scripts\\python -m src.pipeline:*)",
      "Bash(.venv\\Scripts\\python -m src.serve:*)"
    ]
  }
}
