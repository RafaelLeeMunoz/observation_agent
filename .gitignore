# Private working notes (never committed)
private/

# Pipeline cache, SQLite DB, batch files
data/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local virtual environment
.venv/

# Machine-local Claude Code settings
.claude/settings.local.json

# Dashboard process record and server log (machine-local, rewritten on every start)
output/server.json
output/logs/server.log

# Cross-process lock files next to shared logs (src/filelock.py)
.shared.lock
